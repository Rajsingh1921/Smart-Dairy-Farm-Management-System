# ---- Smart Dairy Farm Manager server configuration ----
# Copy this file to server/.env and change every value. Never commit .env.
NODE_ENV=development
PORT=4000

# MySQL connection (create the database and user first - see README)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dairy_app
DB_PASSWORD=change-this-password
DB_NAME=dairy_farm
# Cloud MySQL: set DB_SSL=true. If your provider gives a CA certificate, paste it into
# DB_SSL_CA (one line, with \n where the line breaks are).
DB_SSL=false
DB_SSL_CA=
# Connections kept open per server (default 10; 3 on Vercel).
DB_CONNECTION_LIMIT=

# Long random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
SESSION_HOURS=12

# Optional: if set, the first-run owner setup page asks for this token.
# Strongly recommended when the server is reachable from the internet.
SETUP_TOKEN=

# Set to true when served over HTTPS (production). Defaults to true when NODE_ENV=production.
COOKIE_SECURE=
# Set to true when running behind a reverse proxy such as nginx.
TRUST_PROXY=false
# Only needed if the frontend is served from a different origin than the API.
CORS_ORIGIN=

# Where animal photos are stored (relative to the server folder). Not used on Vercel.
UPLOAD_DIR=uploads
